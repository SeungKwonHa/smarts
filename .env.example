# ── Environment ──────────────────────────────────────────────────────────────
RELAY_ENV=dev
RELAY_DRY_RUN=1          # Set to 0 in prod to enable real writes

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://relay:relay_dev_password@localhost:5432/relay
POSTGRES_PASSWORD=relay_dev_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM (LongCat API — fill after M0 operator checklist) ─────────────────────
LLM_PROVIDER=longcat
LLM_BASE_URL=            # LongCat OpenAI-compatible endpoint
LLM_API_KEY=             # From LongCat console (prepaid 50B-token pack)
LLM_MODEL_T0=            # Fast/cheap model ID — see docs/notes/longcat_api_verified.md
LLM_MODEL_T1=            # Standard model ID (Korean generation quality)
LLM_MODEL_T2=            # Thinking/reasoning model ID
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_DAILY_BUDGET_TOKENS=30000000

# ── FX ────────────────────────────────────────────────────────────────────────
FX_API_URL=https://open.er-api.com/v6/latest   # or bank open API
FX_BUFFER=1.03           # 3% buffer on FX rate in pricing

# ── Marketplace: Naver SmartStore ─────────────────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_SELLER_ID=

# ── Sourcing ──────────────────────────────────────────────────────────────────
RAKUTEN_APP_ID=
# Amazon JP/US: no PA-API assumed initially; page fetch only

# ── Observability ─────────────────────────────────────────────────────────────
LANGFUSE_HOST=           # https://cloud.langfuse.com or self-hosted
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production  # FastAPI sessions
